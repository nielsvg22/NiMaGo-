# Admin (verplicht voor /admin): kies een sterk wachtwoord van minimaal 10 tekens
ADMIN_PASSWORD=
# Optioneel: willekeurige lange tekst voor het ondertekenen van sessies (anders afgeleid van het wachtwoord)
SESSION_SECRET=
# Map voor de SQLite-database (op de server: een persistent volume, bv. /data)
DATA_DIR=./data
# Optioneel: e-mailmelding bij nieuwe berichten via Resend. Berichten komen altijd in de admin terecht.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
